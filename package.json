{
  "name": "smart-drop-integrador",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_USE_ENV_PROXY=1 next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "NODE_USE_ENV_PROXY=1 next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "worker": "NODE_USE_ENV_PROXY=1 tsx --env-file-if-exists=.env src/worker/index.ts",
    "test:integration": "tsx --test tests/*.integration.ts",
    "test:e2e": "playwright test",
    "build:php": "node scripts/build-php.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.0",
    "bullmq": "^5.63.0",
    "dotenv": "^18.0.9",
    "ioredis": "^5.8.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.32"
  },
  "type": "module",
  "engines": {
    "node": ">=22.21.0 <23 || >=24.10.0 <25"
  }
}
