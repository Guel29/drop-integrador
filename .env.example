# Simulation is the default. Real writes are not implemented.
APP_MODE=simulation
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://smartdrop:smartdrop_local@localhost:5432/smartdrop
REDIS_URL=redis://localhost:6379
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Generate a random secret of at least 32 characters
SESSION_SECRET=
ADMIN_EMAIL=admin@example.com
# Generate: npm exec tsx scripts/hash-password.ts (reads ADMIN_PASSWORD from env)
ADMIN_PASSWORD_HASH=
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=http://localhost:3000/api/mercado-livre/callback
# Explicit comma separated account IDs, used to validate notifications
MELI_USER_IDS=
